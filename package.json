{
  "name": "tally-lens",
  "version": "1.0.0",
  "type": "module",
  "description": "Windows Desktop App for extracting Image Bills and syncing/exporting to TallyPrime / Tally.ERP 9",
  "main": "dist-electron/main.js",
  "bin": {
    "tally-lens": "./bin/cli.js"
  },
  "files": [
    "dist",
    "dist-electron",
    "bin"
  ],
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:win": "npm run build && npm run build:electron && electron-builder --win",
    "prepack": "npm run build && npm run build:electron",
    "test": "vitest run"
  },
  "keywords": [
    "tally",
    "tallyprime",
    "invoice-ocr",
    "bill-importer",
    "gst",
    "electron",
    "windows"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4"
  }
}
